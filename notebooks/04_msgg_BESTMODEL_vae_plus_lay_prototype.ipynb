    "# 7.1 Forzar construcción del modelo\n",
    "# ===============================\n",
    "\n",
    "vae.build(input_shape=(None, 128, 128, 3))\n",
    "vae.compile(optimizer=tf.keras.optimizers.Adam())"
   ]
