    "# ===============================\n",
    "# 7. Instanciar VAE\n",
    "# ===============================\n",
    "\n",
    "encoder = Model(encoder_inputs, [z_mean, z_log_var, z], name=\"encoder\")\n",
    "\n",
    "vae = VAE(encoder, decoder, beta=0.001)  # beta pequeño evita colapso\n",
    "\n",
    "vae.compile(optimizer=tf.keras.optimizers.Adam())"
   ]
